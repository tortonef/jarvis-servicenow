#!/bin/sh
# Forced command bound to Jarvis's SSH key in authorized_keys: whatever the client asks, only these verbs exist.
# Output is one line of JSON for the MID Server to hand back to ServiceNow.
LOGS=/var/log/helios-portal
case "$SSH_ORIGINAL_COMMAND" in
    disk_usage)
        df -P "$LOGS" | awk 'NR==2 { gsub("%", "", $5); printf "{\"mount\":\"%s\",\"use_percent\":%s,\"used_kb\":%s,\"available_kb\":%s}\n", $6, $5, $3, $4 }'
        ;;
    clean_logs)
        # RB-SRV-001 step 2: rotated application logs older than 14 days
        n=$(find "$LOGS" -name '*.log.*' -mtime +14 | wc -l)
        find "$LOGS" -name '*.log.*' -mtime +14 -delete
        printf '{"deleted_files":%s}\n' "$n"
        ;;
    restart_portal)
        # RB-SRV-002: restart helios-portal on this node; L2, only ever run for an approved Change
        pkill -u jarvis -f 'http.server 8080' 2>/dev/null; sleep 1
        setsid nohup python3 -m http.server 8080 --directory /srv/portal >/dev/null 2>&1 < /dev/null &
        sleep 2
        if curl -fsS --max-time 5 http://localhost:8080/health >/dev/null 2>&1; then
            printf '{"restarted":true,"healthy":true}
'
        else
            printf '{"restarted":true,"healthy":false}
'
        fi
        ;;
    portal_health)
        if body=$(curl -fsS --max-time 5 http://localhost:8080/health 2>/dev/null); then
            printf '{"healthy":true,"body":"%s"}\n' "$(echo "$body" | tr -dc 'a-zA-Z0-9 ')"
        else
            printf '{"healthy":false}\n'
        fi
        ;;
    *)
        printf '{"error":"unknown verb"}\n'
        exit 2
        ;;
esac
