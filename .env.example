# ServiceNow Personal Developer Instance (https://developer.servicenow.com)
SNOW_INSTANCE=https://devXXXXX.service-now.com
SNOW_USER=admin
SNOW_PASSWORD=change-me

# Any OpenAI-compatible LLM. Default: Groq free tier (https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1

POLL_SECONDS=30

# Push mode: shared secret between ServiceNow and the Jarvis server (python -c "import secrets;print(secrets.token_urlsafe(32))")
JARVIS_TOKEN=change-me-to-a-long-random-string
JARVIS_PORT=8787

# Knowledge search: semantic (local embeddings, default) or keyword
SEARCH=semantic

# Slack Incoming Webhook for P1 notifications (leave empty to disable)
NOTIFY_WEBHOOK_URL=

# PostgreSQL (docker compose). DATABASE_URL is optional when running without compose.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://jarvis:change-me@127.0.0.1:55432/jarvis

# Knowledge base (docs as code): GitHub repo with a knowledge/ folder, or a local DOCS_DIR
DOCS_REPO=tortonef/jarvis-servicenow
DOCS_REF=main
DOCS_POLL_SECONDS=300
# Knowledge gaps as pull requests on DOCS_REPO: fine-grained token for that repo only, Contents + Pull requests
# read/write. Without it, gaps become draft articles in ServiceNow.
# GITHUB_TOKEN=
# DOCS_DIR=./knowledge
JARVIS_KB=Helios Group IT

# On-prem lab (docker compose --profile lab). Samba requires complex passwords.
LAB_ADMIN_PASSWORD=change-me-Lab1!
LAB_USER_PASSWORD=change-me-User1!
LAB_SERVICE_PASSWORD=change-me-Svc1!

# MID Server user on the PDI (role mid_server)
MID_USER=mid.helios
MID_PASSWORD=change-me

# Grafana dashboard (http://127.0.0.1:3300, user admin) and its read-only database login
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
