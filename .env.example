# ServiceNow Personal Developer Instance (https://developer.servicenow.com)
SNOW_INSTANCE=https://devXXXXX.service-now.com
SNOW_USER=admin
SNOW_PASSWORD=change-me

# Any OpenAI-compatible LLM. Default: Groq free tier (https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# Local Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1

POLL_SECONDS=30

# Push mode: shared secret between ServiceNow and the Jarvis server (python -c "import secrets;print(secrets.token_urlsafe(32))")
JARVIS_TOKEN=change-me-to-a-long-random-string
JARVIS_PORT=8787

# Knowledge search: semantic (local embeddings, default) or keyword
SEARCH=semantic
