{
  "uid": "jarvis-ops",
  "title": "Jarvis - Operations (backlog and SLA)",
  "tags": [
    "jarvis"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Open incidents",
      "description": "Active incidents not resolved, at the Watcher's last pass",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(open), 0) FROM backlog_snapshot WHERE taken_at = (SELECT max(taken_at) FROM backlog_snapshot)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLA at risk",
      "description": "Open incidents with a running SLA at or above SLA_WARN_PERCENT, not yet breached",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(at_risk), 0) FROM backlog_snapshot WHERE taken_at = (SELECT max(taken_at) FROM backlog_snapshot)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
