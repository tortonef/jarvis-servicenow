      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Breaches in range",
      "description": "SLA breach alerts Jarvis raised in the selected time range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM sla_alert WHERE level = 'breached' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Open backlog by priority",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT taken_at AS time, 'P' || priority AS metric, sum(open) AS value FROM backlog_snapshot WHERE $__timeFilter(taken_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "At risk and breached",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT taken_at AS time, sum(at_risk) AS \"at risk\", sum(breached) AS breached FROM backlog_snapshot WHERE $__timeFilter(taken_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Backlog by assignment group (now)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(nullif(assignment_group, ''), 'unassigned') AS \"group\", sum(open) AS open, sum(at_risk) AS \"at risk\", sum(breached) AS breached FROM backlog_snapshot WHERE taken_at = (SELECT max(taken_at) FROM backlog_snapshot) GROUP BY 1 ORDER BY 2 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "group",
        "stacking": "none",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "SLA alerts",
      "description": "Each alert put a work note with Jarvis's resolution suggestion on the ticket and was sent to Slack",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"raised\", ticket, level, sla_name AS sla, round(percentage) AS \"%\", planned_end AS \"due (UTC)\", 'P' || priority AS priority, coalesce(nullif(assignment_group, ''), 'unassigned') AS \"group\" FROM sla_alert WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
