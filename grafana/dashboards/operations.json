        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLA breached",
      "description": "Open incidents with a breached SLA",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(breached), 0) FROM backlog_snapshot WHERE taken_at = (SELECT max(taken_at) FROM backlog_snapshot)"
        }
