{
  "uid": "jarvis",
  "title": "Jarvis - Service Desk quality",
  "tags": [
    "jarvis"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "min_answer",
        "label": "Minutes saved per answer",
        "query": "5",
        "current": {
          "text": "5",
          "value": "5"
        },
        "options": [
          {
            "selected": true,
            "text": "5",
            "value": "5"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "min_procedure",
        "label": "Minutes saved per procedure",
        "query": "15",
        "current": {
          "text": "15",
          "value": "15"
        },
        "options": [
          {
            "selected": true,
            "text": "15",
            "value": "15"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "min_deflection",
        "label": "Minutes saved per ticket avoided",
        "query": "20",
        "current": {
          "text": "20",
          "value": "20"
        },
        "options": [
          {
            "selected": true,
            "text": "20",
            "value": "20"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Incidents answered",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM suggestion WHERE kind = 'answer' AND $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Helpful (agent votes)",
      "description": "Share of agent votes on Jarvis suggestions that were 'helpful'.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE helpful) / NULLIF(count(*), 0) FROM feedback WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Self-service deflection",
      "description": "Portal questions solved without a ticket, out of those the user rated.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE solved) / NULLIF(count(*) FILTER (WHERE solved IS NOT NULL), 0) FROM self_service WHERE $__timeFilter(created_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Procedures done (L1 + L2)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM execution WHERE risk IN ('L1', 'L2') AND status = 'succeeded' AND $__timeFilter(proposed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Time saved (est.)",
      "description": "An estimate, not a measurement: answers x $min_answer min + procedures done x $min_procedure min + tickets avoided x $min_deflection min. Change the assumptions in the variables at the top.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT ((SELECT count(*) FROM suggestion WHERE kind = 'answer' AND $__timeFilter(created_at)) * $min_answer + (SELECT count(*) FROM execution WHERE risk IN ('L1', 'L2') AND status = 'succeeded' AND $__timeFilter(proposed_at)) * $min_procedure + (SELECT count(*) FROM self_service WHERE solved AND $__timeFilter(created_at)) * $min_deflection) / 60.0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "dark-green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Jarvis activity per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), count(*) FILTER (WHERE kind = 'answer') AS \"answers\", count(*) FILTER (WHERE kind = 'remediation') AS \"procedures\", count(*) FILTER (WHERE kind IN ('kb_draft', 'kb_covered')) AS \"KB checks\", count(*) FILTER (WHERE kind = 'problem') AS \"problems\" FROM suggestion WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Procedures by risk and status",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT risk, status, count(*) AS runs FROM execution WHERE $__timeFilter(proposed_at) GROUP BY 1, 2 ORDER BY 1, 2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Knowledge gaps: answered without a KB article",
      "description": "Tickets where retrieval found no article: candidates for a new doc.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"time\", ticket FROM suggestion WHERE kind = 'answer' AND NOT sources::text ~ '\"KB' AND $__timeFilter(created_at) ORDER BY 1 DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Not helpful: suggestions to review",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT created_at AS \"time\", ticket, agent FROM feedback WHERE NOT helpful AND $__timeFilter(created_at) ORDER BY 1 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Docs due for review (next 60 days)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jarvis-db"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jarvis-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT id, title, owner, review_by FROM document WHERE review_by < current_date + 60 ORDER BY review_by"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
